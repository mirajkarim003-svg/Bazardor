# Copy this file to .env.local and fill in the values.

# Public site URL (use http://localhost:3000 locally, your Vercel URL in production)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Any long random string, e.g. run: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# MongoDB Atlas connection string (free M0 cluster is enough)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=bazardor

# Google OAuth  -> https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth  -> https://github.com/settings/developers
# Authorization callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
